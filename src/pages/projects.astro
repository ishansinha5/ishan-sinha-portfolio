---
// src/pages/projects.astro
import Layout from '../layouts/Layout.astro';
---

<Layout title="Projects">
  
  <section style="margin-bottom: 4rem;">
    <h1 style="font-size: 3.5rem; text-align: center; margin-bottom: 1rem;">Project Data</h1>
    <p style="text-align: center; font-size: 1.1rem; margin-bottom: 3rem; color: var(--color-secondary);">
      Deployed infrastructure, predictive modeling, and live web architecture.
    </p>

    <div class="comic-panel" style="margin-bottom: 3rem; padding: 1.5rem;">
      <h2 style="font-size: 2.2rem; border-bottom: 4px solid var(--color-black); padding-bottom: 0.5rem; margin-bottom: 2rem;">Personal ML & Full-Stack</h2>
      
      <div class="project-grid">
        
        <div class="project-card">
          <div class="project-header">
            <h3>NBA Finals NLP Predictor</h3>
            <span class="status live">Live on Streamlit</span>
          </div>
          <p>
            An NLP pipeline tracking team momentum metrics via postgame media sentiment. Engineered to utilize real, live scraped data directly from press conferences—aggressively scrubbing broadcast noise to maintain highly accurate dataset integrity.
          </p>
          <div class="project-links">
            <a href="#" class="comic-btn mini-btn">View App</a>
            <a href="#" class="comic-btn mini-btn secondary-btn">GitHub</a>
          </div>
        </div>

        <div class="project-card">
          <div class="project-header">
            <h3>Comic Book Shop Tracker</h3>
            <span class="status dev">Phase 2 in Dev</span>
          </div>
          <p>
            A microservices-based shop locator and inventory tracker currently live on Vercel (Phase 1). Active development on Phase 2 includes massive architectural refactoring to optimize state management and backend routing speeds.
          </p>
          <div class="project-links">
            <a href="#" class="comic-btn mini-btn">Live Deploy</a>
            <a href="#" class="comic-btn mini-btn secondary-btn">GitHub</a>
          </div>
        </div>

      </div>
    </div>

    <div class="comic-panel" style="padding: 1.5rem;">
      <h2 style="font-size: 2.2rem; border-bottom: 4px solid var(--color-black); padding-bottom: 0.5rem; margin-bottom: 2rem;">Academic & Computational</h2>
      
      <div class="project-grid">
        
        <div class="project-card">
          <div class="project-header">
            <h3>NFL Combine Predictive Analysis</h3>
            <span class="status">Python / ML</span>
          </div>
          <p>
            Developed a multi-model ensemble analysis suite (incorporating Random Forest and SVM) to predict and grade 2026 draft classes. Specifically configured to evaluate the Buffalo Bills' ten-pick class, alongside deep-dives into the Ravens and NFC North data.
          </p>
          <div class="project-links">
            <a href="#" class="comic-btn mini-btn secondary-btn">View Repository</a>
          </div>
        </div>

        <div class="project-card">
          <div class="project-header">
            <h3>ISS Telemetry Analytics</h3>
            <span class="status">Computational Modeling</span>
          </div>
          <p>
            Processed and analyzed high-velocity telemetry data streams to calculate structural limits and optimize trajectory modeling. Built leveraging core computational data science principles from CMSE coursework.
          </p>
          <div class="project-links">
            <a href="#" class="comic-btn mini-btn secondary-btn">View Repository</a>
          </div>
        </div>

      </div>
    </div>

  </section>

</Layout>

<style>
  /* =========================================
     PROJECT GRID SYSTEM
     ========================================= */
  .project-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
  }

  .project-card {
    background-color: var(--color-white);
    border: 3px solid var(--color-black);
    padding: 1.5rem;
    box-shadow: 6px 6px 0px rgba(11, 9, 10, 0.1);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .project-card:hover {
    transform: translateY(-4px) translateX(-4px);
    box-shadow: 10px 10px 0px rgba(11, 9, 10, 0.15);
  }

  .project-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 1rem;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .project-header h3 {
    font-size: 1.6rem;
    margin: 0;
    line-height: 1.1;
  }

  .status {
    font-size: 0.8rem;
    font-weight: 800;
    padding: 0.2rem 0.5rem;
    border: 2px solid var(--color-black);
    background-color: var(--color-bg);
    text-transform: uppercase;
    white-space: nowrap;
  }

  .status.live {
    background-color: #2A9D8F; 
    color: var(--color-white);
  }

  .status.dev {
    background-color: var(--color-accent);
  }

  .project-card p {
    font-size: 1rem;
    line-height: 1.5;
    margin-bottom: 2rem;
  }

  .project-links {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .mini-btn {
    font-size: 1.1rem;
    padding: 0.4rem 1rem;
    border-width: 3px;
    box-shadow: 4px 4px 0px var(--color-black);
  }

  .mini-btn:active {
    transform: translate(4px, 4px);
  }

  .secondary-btn {
    background-color: var(--color-bg);
  }
  .secondary-btn:hover {
    background-color: var(--color-secondary);
  }
</style>