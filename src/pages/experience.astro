---
// src/pages/experience.astro
import Layout from '../layouts/Layout.astro';
---

<Layout title="Experience">
  
  <section class="comic-panel" style="margin-bottom: 4rem; position: relative; overflow: hidden;">
    <h1 style="font-size: clamp(2.5rem, 8vw, 3.5rem); text-align: center; margin-bottom: 1rem;">The Webline</h1>
    <p style="text-align: center; font-size: clamp(0.9rem, 3vw, 1.1rem); color: var(--color-secondary); font-weight: 800; text-transform: uppercase;">
      Tracking the trajectory from early foundations to enterprise backend and computational machine learning.
    </p>

    <div class="timeline-container">
      
      <div class="timeline-section-title">Collegiate Experience</div>
      
      <div class="timeline-item">
        <div class="timeline-node"></div>
        <div class="timeline-content">
          <h2>Auto-Owners Insurance</h2>
          <div class="role-row">
            <span class="role-title primary-role">Software Development Intern</span>
            <span class="timeline-date">May 2026 – Aug 2026</span>
          </div>
          <ul>
            <li>Architecting and deploying configuration updates within the enterprise Guidewire Claim Center ecosystem using a proprietary object-oriented tech stack.</li>
            <li>Troubleshooting and optimizing backend software configurations for live production environments.</li>
            <li>Ensuring high reliability and low latency for large-scale insurance claims processing.</li>
          </ul>
        </div>
      </div>

      <div class="timeline-item">
        <div class="timeline-node"></div>
        <div class="timeline-content">
          <h2>Facility for Rare Isotope Beams (FRIB)</h2>
          <div class="role-row">
            <span class="role-title primary-role">Undergraduate Researcher</span>
            <span class="timeline-date">Jan 2026 – Present</span>
          </div>
          <ul>
            <li>Developing a 3D sparse neural network framework to significantly reduce the compute cost of analyzing high-dimensional structures.</li>
            <li>Architecting the model to process only relevant data points for rare event detection using unsupervised learning.</li>
            <li>Collaborating with lab researchers to apply computational machine learning techniques to complex physical datasets.</li>
          </ul>
        </div>
      </div>

      <div class="timeline-item">
        <div class="timeline-node"></div>
        <div class="timeline-content">
          <h2>MSU Drone Team</h2>
          <div class="role-row">
            <span class="role-title primary-role">Software Team Lead</span>
            <span class="timeline-date">Nov 2025 – Present</span>
          </div>
          <div class="role-row secondary-row">
            <span class="role-title secondary-role">Software Team Member</span>
            <span class="timeline-date secondary-date">Aug 2024 – Nov 2025</span>
          </div>
          <ul>
            <li>Directing the software engineering lifecycle for autonomous drone missions, from supervising flight path algorithms to training a proprietary machine learning model for aerial object detection.</li>
            <li>Integrating and stress-testing LIDAR systems across distinct Python environments while strictly adhering to hardware weight and price constraints.</li>
            <li>Programming and validating autonomous flight paths by analyzing ArduPilot telemetry data to ensure obstacle avoidance and mission compliance.</li>
          </ul>
          <a href="https://github.com/MSU-UnmannedSystem/2025_SUAS" target="_blank" class="comic-btn mini-btn" style="margin-top: 1rem;">View Drone GitHub</a>
        </div>
      </div>

      <div class="timeline-item">
        <div class="timeline-node"></div>
        <div class="timeline-content">
          <h2>MSU Engineering Student Council</h2>
          <div class="role-row">
            <span class="role-title primary-role">ECAC Representative</span>
            <span class="timeline-date">Apr 2026 – Present</span>
          </div>
          <ul>
            <li>Serving as the primary undergraduate liaison to the Dean of Engineering, actively voting on collegiate policies and advocating for the academic interests of the student body.</li>
            <li>Providing strategic insight on curriculum and college-wide initiatives during executive committee meetings to improve the program's function and image.</li>
          </ul>
        </div>
      </div>

      <div class="timeline-item">
        <div class="timeline-node"></div>
        <div class="timeline-content">
          <h2>Spartan Cybersecurity Club</h2>
          <div class="role-row">
            <span class="role-title primary-role">Secretary & Director of Outreach and Social Media</span>
            <span class="timeline-date">Mar 2025 – Present</span>
          </div>
          <ul>
            <li>Coordinating outreach for capstone and recruitment events, driving a 200% increase in member turnout.</li>
            <li>Researching and presenting workshops on advanced security topics to members, including satellite hacking and CVE analysis.</li>
            <li>Participating in network defense simulations and evaluating system vulnerabilities.</li>
          </ul>
        </div>
      </div>

      <div class="web-divider"></div>

      <div class="timeline-section-title">Pre-Collegiate Experience</div>

      <div class="timeline-item">
        <div class="timeline-node"></div>
        <div class="timeline-content">
          <h2>Code Ninjas</h2>
          <div class="role-row">
            <span class="role-title primary-role">Lead Code Sensei</span>
            <span class="timeline-date">Jan 2023 – Jul 2024</span>
          </div>
          <div class="role-row secondary-row">
            <span class="role-title secondary-role">Code Sensei</span>
            <span class="timeline-date secondary-date">Jul 2021 – Dec 2022</span>
          </div>
          <ul>
            <li>Led a team of instructors to deliver personalized coaching in Scratch, JavaScript, Lua, and C#, contributing to over 50 new enrollments through community outreach.</li>
            <li>Spearheaded the rollout of the IMPACT learning platform, modernizing the curriculum for sessions of 20+ students.</li>
            <li>Translated complex object-oriented programming concepts into digestible logic for younger students.</li>
          </ul>
        </div>
      </div>

      <div class="timeline-item">
        <div class="timeline-node"></div>
        <div class="timeline-content">
          <h2>Encora</h2>
          <div class="role-row">
            <span class="role-title primary-role">Software Development Intern</span>
            <span class="timeline-date">Jul 2023 – Aug 2023</span>
          </div>
          <ul>
            <li>Created a polling web application utilizing full-stack approaches through the Django Python framework.</li>
            <li>Built a data processing module to rank and filter user-generated poll data in real time based on user inputs.</li>
            <li>Collaborated in a remote environment to deliver clean, documented code on a strict deadline.</li>
          </ul>
        </div>
      </div>

    </div>
  </section>

</Layout>

<style>
  .timeline-container {
    position: relative;
    padding-left: 56px;
    margin: 0 auto;
    max-width: 820px;
  }

  .timeline-container::before {
    content: '';
    position: absolute;
    top: -300px;
    bottom: -300px;
    left: 16px; 
    width: 16px;
    background-image: url("data:image/svg+xml,%3Csvg width='16' height='120' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M 8 0 L 8 120' stroke='%230B090A' stroke-width='3.6' fill='none'/%3E%3Cpath d='M 8 0 L 8 120' stroke='%23FAFAFA' stroke-width='2' fill='none'/%3E%3Cpath d='M 0 15 Q 16 30 8 60 T 16 105' stroke='%230B090A' stroke-width='2.4' fill='none'/%3E%3Cpath d='M 0 15 Q 16 30 8 60 T 16 105' stroke='%23FAFAFA' stroke-width='1.6' fill='none'/%3E%3Cpath d='M 16 0 Q 0 20 8 45 T 0 90' stroke='%230B090A' stroke-width='2.4' fill='none'/%3E%3Cpath d='M 16 0 Q 0 20 8 45 T 0 90' stroke='%23FAFAFA' stroke-width='1.6' fill='none'/%3E%3Cpath d='M 4 10 Q 12 40 4 70 T 12 110' stroke='%230B090A' stroke-width='2.4' fill='none'/%3E%3Cpath d='M 4 10 Q 12 40 4 70 T 12 110' stroke='%23FAFAFA' stroke-width='1.6' fill='none'/%3E%3C/svg%3E");
    background-repeat: repeat-y;
    z-index: 0;
  }

  .timeline-section-title {
    font-family: 'Bangers', cursive;
    font-size: clamp(1.5rem, 5vw, 2rem);
    color: var(--color-white);
    background-color: var(--color-black);
    display: inline-block;
    padding: 0.2rem 1rem;
    margin-bottom: 2rem;
    margin-left: 0;
    position: relative;
    z-index: 2;
    transform: rotate(-2deg);
    box-shadow: 4px 4px 0px var(--color-primary);
  }

  .timeline-item {
    position: relative;
    margin-bottom: 2.5rem;
  }

  .timeline-node {
    position: absolute;
    left: -44px; 
    top: 15%; 
    transform: translateY(-50%); 
    z-index: 3;
    width: 24px;
    height: 24px;
    background-color: var(--color-white);
    border: 4px solid var(--color-black);
    border-radius: 50%;
    box-shadow: 2px 2px 0px var(--color-black);
  }

  .timeline-content {
    position: relative;
    background-color: var(--color-panel);
    border: 3px solid var(--color-black);
    padding: clamp(1rem, 3vw, 1.5rem);
    border-radius: 2px 15px 2px 15px;
    box-shadow: 5px 5px 0px var(--color-black);
    width: 100%;
    box-sizing: border-box;
    z-index: 1;
  }

  .timeline-content ul {
    margin: 0.2rem 0;
    padding-left: 1.5rem;
  }

  .timeline-content::before {
    content: '';
    position: absolute;
    top: 0px;
    bottom: 0px;
    left: -32px;
    width: 32px;
    background-image: url("data:image/svg+xml,%3Csvg preserveAspectRatio='none' viewBox='0 0 100 100' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M 0 15 Q 40 15 100 0 M 0 15 Q 40 15 100 25 M 0 15 L 100 50 M 0 15 Q 40 15 100 75 M 0 15 Q 40 15 100 100 M 35 15 Q 50 15 35 50 M 65 15 Q 85 15 65 50' stroke='%230B090A' stroke-width='2.6' fill='none' stroke-linejoin='round' stroke-linecap='round'/%3E%3Cpath d='M 0 15 Q 40 15 100 0 M 0 15 Q 40 15 100 25 M 0 15 L 100 50 M 0 15 Q 40 15 100 75 M 0 15 Q 40 15 100 100 M 35 15 Q 50 15 35 50 M 65 15 Q 85 15 65 50' stroke='%23FAFAFA' stroke-width='1.4' fill='none' stroke-linejoin='round' stroke-linecap='round'/%3E%3C/svg%3E");
    background-size: 100% 100%;
    z-index: -1;
  }

  .timeline-content h2 {
    font-size: clamp(1.5rem, 5vw, 1.8rem);
    margin: 0 0 0.5rem 0;
  }

  .role-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.5rem;
    margin-bottom: 0.15rem;
    flex-wrap: wrap; 
  }

  /* This forces the title and date to stack neatly on phones */
  @media (max-width: 600px) {
    .role-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.2rem;
    }
  }

  .role-title {
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--color-secondary);
    word-break: break-word; /* Prevents long words from bleeding out */
  }

  .primary-role {
    font-size: clamp(0.75rem, 3.5vw, 0.95rem);
  }

  .secondary-role {
    font-size: clamp(0.7rem, 3vw, 0.855rem);
    opacity: 0.8;
  }

  .timeline-date {
    font-weight: 700;
    color: var(--color-secondary);
    font-size: clamp(0.7rem, 3vw, 0.85rem);
    text-transform: uppercase;
    letter-spacing: 0.3px;
    text-align: left;
  }

  .secondary-row {
    margin-bottom: 0.25rem;
  }

  .role-row + ul,
  .secondary-row + ul {
    border-top: 1px solid rgba(11,9,10,0.12);
    padding-top: 0.5rem;
    margin-top: 0.5rem;
  }

  .timeline-content li {
    margin-bottom: 0.5rem;
    line-height: 1.5;
    font-size: clamp(0.9rem, 3vw, 1rem);
  }

  .web-divider {
    height: 4px;
    background-color: var(--color-black);
    margin: 2.5rem 0;
    position: relative;
    z-index: 2;
  }

  .mini-btn {
    font-size: clamp(0.9rem, 3vw, 1.1rem) !important;
    padding: 0.4rem 1rem !important;
    border-width: 3px !important;
    box-shadow: 4px 4px 0px var(--color-black) !important;
  }
</style>