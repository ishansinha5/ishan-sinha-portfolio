---
// src/pages/experience.astro
import Layout from '../layouts/Layout.astro';
---

<Layout title="Experience">
  
  <section class="comic-panel" style="margin-bottom: 4rem;">
    <h1 style="font-size: 3.5rem; text-align: center; margin-bottom: 1rem;">The Webline</h1>
    <p style="text-align: center; font-size: 1.1rem; margin-bottom: 3rem; color: var(--color-secondary);">
      Tracking the trajectory from early foundations to enterprise backend and computational machine learning.
    </p>

    <div class="timeline-container">
      
      <div class="timeline-section-title">Current & Collegiate</div>
      
      <div class="timeline-item">
        <div class="timeline-node"></div>
        <div class="timeline-content">
          <h2>Auto-Owners Insurance</h2>
          <span class="timeline-date">Started May 11, 2026</span>
          <p><strong>Software Development Intern.</strong> Focused on enterprise-scale backend development utilizing Java and Gosu to support heavy internal infrastructure.</p>
        </div>
      </div>

      <div class="timeline-item">
        <div class="timeline-node"></div>
        <div class="timeline-content">
          <h2>FRIB (Facility for Rare Isotope Beams)</h2>
          <span class="timeline-date">Michigan State University</span>
          <p><strong>Machine Learning Research.</strong> Applying computational ML techniques to optimize data pipelines and processing efficiency for Department of Energy operations.</p>
        </div>
      </div>

      <div class="timeline-item">
        <div class="timeline-node"></div>
        <div class="timeline-content">
          <h2>MSU Unmanned Systems</h2>
          <span class="timeline-date">Collegiate SUAS Competition</span>
          <p><strong>Drone Telemetry Lead.</strong> Orchestrating real-time data streams and telemetry infrastructure for autonomous flight systems.</p>
        </div>
      </div>

      <div class="timeline-item">
        <div class="timeline-node"></div>
        <div class="timeline-content">
          <h2>Spartan Cybersecurity Club</h2>
          <span class="timeline-date">Michigan State University</span>
          <p>Active member engaging in threat modeling, system defense, and secure backend architecture principles.</p>
        </div>
      </div>

      <div class="timeline-item">
        <a href="/projects" class="timeline-node interactive-node" title="View Project Data"></a>
        <div class="timeline-content">
          <h2>CMSE 201 & 202 Core Computational Projects</h2>
          <span class="timeline-date">Academic Infrastructure</span>
          <p>Foundational computational modeling and data science coursework. <a href="/projects" style="color: var(--color-primary); font-weight: bold;">Click the web node to view the deployed projects.</a></p>
        </div>
      </div>

      <div class="web-divider"></div>

      <div class="timeline-section-title" style="margin-top: 2rem;">Early Foundation</div>

      <div class="timeline-item">
        <div class="timeline-node"></div>
        <div class="timeline-content">
          <h2>Encora & Code Ninjas</h2>
          <span class="timeline-date">Pre-Collegiate Trajectory</span>
          <p>Early software development experience establishing the baseline for code structure, logical problem solving, and full-stack familiarity.</p>
        </div>
      </div>

    </div>
  </section>

</Layout>

<style>
  /* =========================================
     TIMELINE ARCHITECTURE (Native CSS & SVG)
     ========================================= */

  section.comic-panel {
    overflow: hidden;
    position: relative;
  }
  
  .timeline-container {
    position: relative;
    padding-left: 2rem;
    margin: 0 auto;
    max-width: 700px;
  }

  .timeline-container::before {
    content: '';
    position: absolute;
    top: -300px;   
    bottom: -100px; 
    left: 24px; 
    width: 16px; 
    background-image: url("data:image/svg+xml,%3Csvg width='16' height='120' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M 8 0 L 8 120' stroke='%230B090A' stroke-width='3.6' fill='none'/%3E%3Cpath d='M 8 0 L 8 120' stroke='%23FAFAFA' stroke-width='2' fill='none'/%3E%3Cpath d='M 0 15 Q 16 30 8 60 T 16 105' stroke='%230B090A' stroke-width='2.4' fill='none'/%3E%3Cpath d='M 0 15 Q 16 30 8 60 T 16 105' stroke='%23FAFAFA' stroke-width='1.6' fill='none'/%3E%3Cpath d='M 16 0 Q 0 20 8 45 T 0 90' stroke='%230B090A' stroke-width='2.4' fill='none'/%3E%3Cpath d='M 16 0 Q 0 20 8 45 T 0 90' stroke='%23FAFAFA' stroke-width='1.6' fill='none'/%3E%3Cpath d='M 4 10 Q 12 40 4 70 T 12 110' stroke='%230B090A' stroke-width='2.4' fill='none'/%3E%3Cpath d='M 4 10 Q 12 40 4 70 T 12 110' stroke='%23FAFAFA' stroke-width='1.6' fill='none'/%3E%3C/svg%3E");
    background-repeat: repeat-y;
    z-index: 0; 
  }

  .timeline-section-title {
    font-family: 'Bangers', cursive;
    font-size: 2rem;
    color: var(--color-white);
    background-color: var(--color-black);
    display: inline-block;
    padding: 0.2rem 1rem;
    margin-bottom: 2rem;
    position: relative;
    z-index: 2;
    transform: rotate(-2deg);
    box-shadow: 4px 4px 0px var(--color-primary);
  }

  .timeline-item {
    position: relative;
    margin-bottom: 3rem;
    display: flex;
    align-items: flex-start;
  }

  .timeline-node {
    flex-shrink: 0;
    position: relative;
    z-index: 3; 
    width: 24px;
    height: 24px;
    background-color: var(--color-white);
    border: 4px solid var(--color-black);
    border-radius: 50%;
    margin-left: -8px; 
    margin-right: 2rem; 
    margin-top: 24px; 
    box-shadow: 3px 3px 0px var(--color-black);
  }

  .interactive-node {
    background-color: var(--color-accent);
    cursor: pointer;
    transition: transform 0.1s ease, box-shadow 0.1s ease;
  }
  .interactive-node:hover {
    background-color: var(--color-primary);
    transform: scale(1.2);
    box-shadow: 5px 5px 0px var(--color-black);
  }

  .timeline-content {
    position: relative;
    background-color: var(--color-bg);
    border: 3px solid var(--color-black);
    padding: 1.5rem 1.5rem 1.5rem 2.5rem; 
    border-radius: 2px 15px 2px 15px;
    box-shadow: 5px 5px 0px var(--color-black);
    width: 100%;
    z-index: 1; 
  }

  /* The "Splat & Stretch" Web */
  .timeline-content::before {
    content: '';
    position: absolute;
    top: 0px;      
    bottom: 0px;   
    left: -44px;    
    width: 44px;  
    background-image: url("data:image/svg+xml,%3Csvg preserveAspectRatio='none' viewBox='0 0 100 100' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M 0 22 Q 40 22 100 0 M 0 22 Q 40 22 100 11 M 0 22 L 100 22 M 0 22 Q 40 22 100 33 M 0 22 Q 40 22 100 44 M 35 7 Q 50 22 35 37 M 65 3 Q 85 22 65 41' stroke='%230B090A' stroke-width='2.6' fill='none' stroke-linejoin='round' stroke-linecap='round'/%3E%3Cpath d='M 0 22 Q 40 22 100 0 M 0 22 Q 40 22 100 11 M 0 22 L 100 22 M 0 22 Q 40 22 100 33 M 0 22 Q 40 22 100 44 M 35 7 Q 50 22 35 37 M 65 3 Q 85 22 65 41' stroke='%23FAFAFA' stroke-width='1.4' fill='none' stroke-linejoin='round' stroke-linecap='round'/%3E%3C/svg%3E");
    background-size: 100% 100%;
    z-index: -1; 
  }

  .timeline-content h2 {
    font-size: 1.8rem;
    margin-bottom: 0.2rem;
  }

  .timeline-date {
    display: block;
    font-weight: 800;
    color: var(--color-primary);
    margin-bottom: 1rem;
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .timeline-content p {
    margin: 0;
    line-height: 1.5;
  }

  .web-divider {
    height: 4px;
    background-color: var(--color-black);
    margin: 3rem 0;
    position: relative;
    z-index: 2;
    width: 100%;
  }
</style>