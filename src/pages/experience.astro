<style>
  /* 
   * SPINE is a fixed left rail. We give the container enough left-padding 
   * so the spine + node + web all sit to the left of the content boxes.
   * 
   * Layout (left→right from container edge):
   *   0px  = container left edge
   *   8px  = spine center  (spine is 16px wide, left:0, so center at 8px)
   *   20px = node center   (node: left:8px, width:24px → center at 8+12=20px)
   *   64px = start of content box
   *
   * web bridges from node-center (20px) to box-left (64px) = 44px wide
   */

  section {
    /* no comic-panel class — no white box */
  }

  .timeline-container {
    position: relative;
    padding-left: 64px;
    margin: 0 auto;
    max-width: 820px;
  }

  /* ── Spine ────────────────────────────────────────────────────── */
  .timeline-container::before {
    content: '';
    position: absolute;
    top: -60px;
    bottom: -60px;
    left: 0;
    width: 16px;
    background-image: url("data:image/svg+xml,%3Csvg width='16' height='120' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M 8 0 L 8 120' stroke='%230B090A' stroke-width='3.6' fill='none'/%3E%3Cpath d='M 8 0 L 8 120' stroke='%23FAFAFA' stroke-width='2' fill='none'/%3E%3Cpath d='M 0 15 Q 16 30 8 60 T 16 105' stroke='%230B090A' stroke-width='2.4' fill='none'/%3E%3Cpath d='M 0 15 Q 16 30 8 60 T 16 105' stroke='%23FAFAFA' stroke-width='1.6' fill='none'/%3E%3Cpath d='M 16 0 Q 0 20 8 45 T 0 90' stroke='%230B090A' stroke-width='2.4' fill='none'/%3E%3Cpath d='M 16 0 Q 0 20 8 45 T 0 90' stroke='%23FAFAFA' stroke-width='1.6' fill='none'/%3E%3Cpath d='M 4 10 Q 12 40 4 70 T 12 110' stroke='%230B090A' stroke-width='2.4' fill='none'/%3E%3Cpath d='M 4 10 Q 12 40 4 70 T 12 110' stroke='%23FAFAFA' stroke-width='1.6' fill='none'/%3E%3C/svg%3E");
    background-repeat: repeat-y;
    z-index: 0;
  }

  /* ── Section labels ───────────────────────────────────────────── */
  .timeline-section-title {
    font-family: 'Bangers', cursive;
    font-size: 2rem;
    color: var(--color-white);
    background-color: var(--color-black);
    display: inline-block;
    padding: 0.2rem 1rem;
    margin-bottom: 2rem;
    margin-left: 0;
    position: relative;
    z-index: 2;
    transform: rotate(-2deg);
    box-shadow: 4px 4px 0px var(--color-primary);
  }

  /* ── Timeline item wrapper ────────────────────────────────────── */
  .timeline-item {
    position: relative;
    margin-bottom: 2.5rem;
  }

  /* ── Node — sits on spine center (left: 8px = spine center, offset by half node width = 12px → left: 8-12 = -4px from container) ── */
  .timeline-node {
    position: absolute;
    left: -56px;   /* spine-center is at 8px from container-left; container has 64px padding; so from item-left: -(64-8) = -56px */
    top: 20px;     /* aligns with h2 cap height roughly */
    z-index: 3;
    width: 24px;
    height: 24px;
    background-color: var(--color-white);
    border: 4px solid var(--color-black);
    border-radius: 50%;
    box-shadow: 2px 2px 0px var(--color-black);
  }

  /* ── Web lines: from node right-edge to content box left-edge ── */
  /* node right-edge: -56px + 24px = -32px from item-left
     content box left-edge: 0px
     so web spans from -32px to 0 = 32px wide */
  .timeline-content::before {
    content: '';
    position: absolute;
    left: -32px;
    top: 8px;
    bottom: 8px;
    width: 32px;
    background-image: url("data:image/svg+xml,%3Csvg preserveAspectRatio='none' viewBox='0 0 32 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M 0 30 L 32 30' stroke='%230B090A' stroke-width='2.5' fill='none'/%3E%3Cpath d='M 0 30 L 32 30' stroke='%23FAFAFA' stroke-width='1.2' fill='none'/%3E%3Cpath d='M 0 30 Q 16 30 32 10' stroke='%230B090A' stroke-width='2' fill='none'/%3E%3Cpath d='M 0 30 Q 16 30 32 10' stroke='%23FAFAFA' stroke-width='1' fill='none'/%3E%3Cpath d='M 0 30 Q 16 30 32 50' stroke='%230B090A' stroke-width='2' fill='none'/%3E%3Cpath d='M 0 30 Q 16 30 32 50' stroke='%23FAFAFA' stroke-width='1' fill='none'/%3E%3Cpath d='M 0 30 Q 12 22 20 10' stroke='%230B090A' stroke-width='1.6' fill='none'/%3E%3Cpath d='M 0 30 Q 12 22 20 10' stroke='%23FAFAFA' stroke-width='0.8' fill='none'/%3E%3Cpath d='M 0 30 Q 12 38 20 50' stroke='%230B090A' stroke-width='1.6' fill='none'/%3E%3Cpath d='M 0 30 Q 12 38 20 50' stroke='%23FAFAFA' stroke-width='0.8' fill='none'/%3E%3C/svg%3E");
    background-size: 100% 100%;
    z-index: 2;
    pointer-events: none;
  }

  /* ── Content box ──────────────────────────────────────────────── */
  .timeline-content {
    position: relative;
    background-color: var(--color-panel);
    border: 3px solid var(--color-black);
    padding: 1.25rem 1.5rem;
    border-radius: 2px 15px 2px 15px;
    box-shadow: 5px 5px 0px var(--color-black);
    width: 100%;
    box-sizing: border-box;
    z-index: 1;
  }

  .timeline-content h2 {
    font-size: 1.8rem;
    margin: 0 0 0.5rem 0;
  }

  /* ── Role rows — resume style: title left, date right ─────────── */
  .role-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    margin-bottom: 0.15rem;
  }

  .role-title {
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--color-primary);
    flex-shrink: 0;
  }

  .primary-role {
    font-size: 0.95rem;
  }

  .secondary-role {
    font-size: 0.855rem; /* ~10% smaller than primary */
    opacity: 0.8;
  }

  .timeline-date {
    font-weight: 700;
    color: var(--color-primary);
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.3px;
    white-space: nowrap;
    text-align: right;
  }

  .secondary-row {
    margin-bottom: 0.25rem;
  }

  .secondary-date {
    opacity: 0.8;
    font-size: 0.8rem;
  }

  /* thin rule between role rows and bullets */
  .role-row + ul,
  .secondary-row + ul {
    border-top: 1px solid rgba(11,9,10,0.12);
    padding-top: 0.5rem;
    margin-top: 0.5rem;
  }

  .timeline-content ul {
    margin: 0.6rem 0 0.3rem 0;
    padding-left: 1.5rem;
  }

  .timeline-content li {
    margin-bottom: 0.5rem;
    line-height: 1.5;
  }

  /* ── Divider ──────────────────────────────────────────────────── */
  .web-divider {
    height: 4px;
    background-color: var(--color-black);
    margin: 2.5rem 0;
    position: relative;
    z-index: 2;
  }

  /* ── Mini button ──────────────────────────────────────────────── */
  .mini-btn {
    font-size: 1.1rem !important;
    padding: 0.4rem 1rem !important;
    border-width: 3px !important;
    box-shadow: 4px 4px 0px var(--color-black) !important;
  }
</style>