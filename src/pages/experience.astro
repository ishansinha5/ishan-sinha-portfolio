---
// src/pages/experience.astro
import Layout from '../layouts/Layout.astro';
---

<Layout title="Experience">
  
  <section class="comic-panel" style="margin-bottom: 4rem; position: relative; overflow: hidden;">
    <h1 style="font-size: 3.5rem; text-align: center; margin-bottom: 1rem;">The Webline</h1>
    <p style="text-align: center; font-size: 1.1rem; margin-bottom: 3rem; color: var(--color-secondary);">
      Tracking the trajectory from early foundations to enterprise backend and computational machine learning.
    </p>

    <div class="timeline-container">
      
      <div class="timeline-section-title">Collegiate Experience</div>
      
      <div class="timeline-item">
        <div class="timeline-node"></div>
        <div class="timeline-content">
          <h2>Auto-Owners Insurance</h2>
          <div class="role-row">
            <span class="role-title primary-role">Software Engineering Intern</span>
            <span class="timeline-date">May 2026 – Aug 2026</span>
          </div>
          <ul>
            <li></li>
            <li></li>
            <li></li>
          </ul>
        </div>
      </div>

      <div class="timeline-item">
        <div class="timeline-node"></div>
        <div class="timeline-content">
          <h2>MSU Engineering Student Council</h2>
          <div class="role-row">
            <span class="role-title primary-role">Member</span>
            <span class="timeline-date">Apr 2026 – Present</span>
          </div>
          <ul>
            <li></li>
            <li></li>
            <li></li>
          </ul>
        </div>
      </div>

      <div class="timeline-item">
        <div class="timeline-node"></div>
        <div class="timeline-content">
          <h2>MSU Drone Team</h2>
          <div class="role-row">
            <span class="role-title primary-role">Software Team Lead</span>
            <span class="timeline-date">Nov 2025 – Present</span>
          </div>
          <div class="role-row secondary-row">
            <span class="role-title secondary-role">Software Team Member</span>
            <span class="timeline-date secondary-date">Aug 2024 – Nov 2025</span>
          </div>
          <ul>
            <li></li>
            <li></li>
            <li></li>
          </ul>
          <a href="https://github.com/your-drone-repo" target="_blank" class="comic-btn mini-btn" style="margin-top: 1rem;">View Drone GitHub</a>
        </div>
      </div>

      <div class="timeline-item">
        <div class="timeline-node"></div>
        <div class="timeline-content">
          <h2>Spartan Cybersecurity Club</h2>
          <div class="role-row">
            <span class="role-title primary-role">Member</span>
            <span class="timeline-date">Mar 2025 – May 2026</span>
          </div>
          <ul>
            <li></li>
            <li></li>
            <li></li>
          </ul>
        </div>
      </div>

      <div class="web-divider"></div>

      <div class="timeline-section-title">Pre-Collegiate Experience</div>

      <div class="timeline-item">
        <div class="timeline-node"></div>
        <div class="timeline-content">
          <h2>Code Ninjas</h2>
          <div class="role-row">
            <span class="role-title primary-role">Lead Code Sensei</span>
            <span class="timeline-date">Jan 2023 – Jul 2024</span>
          </div>
          <div class="role-row secondary-row">
            <span class="role-title secondary-role">Code Sensei</span>
            <span class="timeline-date secondary-date">Jul 2021 – Dec 2022</span>
          </div>
          <ul>
            <li></li>
            <li></li>
            <li></li>
          </ul>
        </div>
      </div>

      <div class="timeline-item">
        <div class="timeline-node"></div>
        <div class="timeline-content">
          <h2>Encora</h2>
          <div class="role-row">
            <span class="role-title primary-role">Software Intern</span>
            <span class="timeline-date">Jul 2023 – Aug 2023</span>
          </div>
          <ul>
            <li></li>
            <li></li>
            <li></li>
          </ul>
        </div>
      </div>

    </div>
  </section>

</Layout>

<style>
  .timeline-container {
    position: relative;
    padding-left: 56px;
    margin: 0 auto;
    max-width: 820px;
  }

  /* The Main Webline - Extended heavily to clip against the panel borders */
  .timeline-container::before {
    content: '';
    position: absolute;
    top: -300px;
    bottom: -300px;
    left: 16px; 
    width: 16px;
    background-image: url("data:image/svg+xml,%3Csvg width='16' height='120' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M 8 0 L 8 120' stroke='%230B090A' stroke-width='3.6' fill='none'/%3E%3Cpath d='M 8 0 L 8 120' stroke='%23FAFAFA' stroke-width='2' fill='none'/%3E%3Cpath d='M 0 15 Q 16 30 8 60 T 16 105' stroke='%230B090A' stroke-width='2.4' fill='none'/%3E%3Cpath d='M 0 15 Q 16 30 8 60 T 16 105' stroke='%23FAFAFA' stroke-width='1.6' fill='none'/%3E%3Cpath d='M 16 0 Q 0 20 8 45 T 0 90' stroke='%230B090A' stroke-width='2.4' fill='none'/%3E%3Cpath d='M 16 0 Q 0 20 8 45 T 0 90' stroke='%23FAFAFA' stroke-width='1.6' fill='none'/%3E%3Cpath d='M 4 10 Q 12 40 4 70 T 12 110' stroke='%230B090A' stroke-width='2.4' fill='none'/%3E%3Cpath d='M 4 10 Q 12 40 4 70 T 12 110' stroke='%23FAFAFA' stroke-width='1.6' fill='none'/%3E%3C/svg%3E");
    background-repeat: repeat-y;
    z-index: 0;
  }

  .timeline-section-title {
    font-family: 'Bangers', cursive;
    font-size: 2rem;
    color: var(--color-white);
    background-color: var(--color-black);
    display: inline-block;
    padding: 0.2rem 1rem;
    margin-bottom: 2rem;
    margin-left: 0;
    position: relative;
    z-index: 2;
    transform: rotate(-2deg);
    box-shadow: 4px 4px 0px var(--color-primary);
  }

  .timeline-item {
    position: relative;
    margin-bottom: 2.5rem;
  }

  /* Locked Node - centers exactly on the 16px spine */
  .timeline-node {
    position: absolute;
    left: -44px; 
    top: 14px;
    z-index: 3;
    width: 24px;
    height: 24px;
    background-color: var(--color-white);
    border: 4px solid var(--color-black);
    border-radius: 50%;
    box-shadow: 2px 2px 0px var(--color-black);
  }

  /* Shrunk content boxes */
  .timeline-content {
    position: relative;
    background-color: var(--color-panel);
    border: 3px solid var(--color-black);
    padding: 1rem 1.5rem;
    border-radius: 2px 15px 2px 15px;
    box-shadow: 5px 5px 0px var(--color-black);
    width: 100%;
    box-sizing: border-box;
    z-index: 1;
  }

  .timeline-content ul {
    margin: 0.2rem 0;
    padding-left: 1.5rem;
  }

  /* Locked Web Splat */
  .timeline-content::before {
    content: '';
    position: absolute;
    top: 0px;
    bottom: 0px;
    left: -32px;
    width: 32px;
    background-image: url("data:image/svg+xml,%3Csvg preserveAspectRatio='none' viewBox='0 0 100 100' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M 0 15 Q 40 15 100 0 M 0 15 Q 40 15 100 25 M 0 15 L 100 50 M 0 15 Q 40 15 100 75 M 0 15 Q 40 15 100 100 M 35 15 Q 50 15 35 50 M 65 15 Q 85 15 65 50' stroke='%230B090A' stroke-width='2.6' fill='none' stroke-linejoin='round' stroke-linecap='round'/%3E%3Cpath d='M 0 15 Q 40 15 100 0 M 0 15 Q 40 15 100 25 M 0 15 L 100 50 M 0 15 Q 40 15 100 75 M 0 15 Q 40 15 100 100 M 35 15 Q 50 15 35 50 M 65 15 Q 85 15 65 50' stroke='%23FAFAFA' stroke-width='1.4' fill='none' stroke-linejoin='round' stroke-linecap='round'/%3E%3C/svg%3E");
    background-size: 100% 100%;
    z-index: -1;
  }

  .timeline-content h2 {
    font-size: 1.8rem;
    margin: 0 0 0.5rem 0;
  }

  .role-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    margin-bottom: 0.15rem;
  }

  .role-title {
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--color-primary);
    flex-shrink: 0;
  }

  .primary-role {
    font-size: 0.95rem;
  }

  .secondary-role {
    font-size: 0.855rem;
    opacity: 0.8;
  }

  .timeline-date {
    font-weight: 700;
    color: var(--color-primary);
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.3px;
    white-space: nowrap;
    text-align: right;
  }

  .secondary-row {
    margin-bottom: 0.25rem;
  }

  .secondary-date {
    opacity: 0.8;
    font-size: 0.8rem;
  }

  .role-row + ul,
  .secondary-row + ul {
    border-top: 1px solid rgba(11,9,10,0.12);
    padding-top: 0.5rem;
    margin-top: 0.5rem;
  }

  .timeline-content li {
    margin-bottom: 0.5rem;
    line-height: 1.5;
  }

  .web-divider {
    height: 4px;
    background-color: var(--color-black);
    margin: 2.5rem 0;
    position: relative;
    z-index: 2;
  }

  .mini-btn {
    font-size: 1.1rem !important;
    padding: 0.4rem 1rem !important;
    border-width: 3px !important;
    box-shadow: 4px 4px 0px var(--color-black) !important;
  }
</style>