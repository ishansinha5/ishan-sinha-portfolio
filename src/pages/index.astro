---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
---

<Layout title="Home">
  
  <section class="comic-panel" style="margin-bottom: 3rem; display: flex; gap: 2rem; align-items: center; flex-wrap: wrap;">
    <img src="/ishan-sinha-portfolio/profile.jpg" alt="Ishan Sinha" style="flex-shrink: 0; width: 250px; height: 250px; object-fit: cover; background-color: var(--color-secondary); border: 4px solid var(--color-black); border-radius: 50%; box-shadow: 6px 6px 0px var(--color-black);" />
    
    <div style="flex: 1; min-width: 300px;">
      <h1 style="font-size: 3.5rem; margin-bottom: 0.5rem;">
        Hey, I'm <span class="text-highlight">Ishan</span>.
      </h1>
      <h2 style="color: var(--color-secondary); margin-bottom: 1rem;">Aspiring AI Systems & Efficiency Engineer</h2>
      <p style="font-size: 1.1rem; line-height: 1.6; margin-bottom: 1rem;">
        I'm a Computer Science student at Michigan State University, concentrating in Artificial Intelligence and minoring in Data Science, Mathematics, and Computational Mathematics, Science and Engineering (CMSE). I love diving into the weeds of how systems work. My primary focus is on machine learning infrastructure and compute optimization, specifically in finding ways to make AI models run faster and use less energy.
      </p>
      <p style="font-size: 1.1rem; line-height: 1.6;">
        Outside of that, I'm really passionate about autonomous drones and cybersecurity, which gives me a hands-on way to apply what I learn in class to real hardware and network environments.
      </p>
    </div>
  </section>

  <section class="comic-panel" style="margin-bottom: 4rem; padding: 1.5rem 2rem;">
    <h2 style="text-align: center; font-size: 2.5rem; margin-bottom: 2rem;">Methods of Communication</h2>
    
    <div style="display: flex; justify-content: center; gap: 1.5rem; flex-wrap: wrap;">
      <a href="/ishan-sinha-portfolio/Ishan_Sinha_Resume.pdf" download class="comic-btn">Download Resume</a>
      <a href="mailto:prof.ishan.sinha@gmail.com" class="comic-btn">Email</a>
      <a href="https://github.com/ishansinha5" target="_blank" class="comic-btn">GitHub</a>
      <a href="https://www.linkedin.com/in/sinhai/" target="_blank" class="comic-btn">LinkedIn</a>
    </div>
  </section>

</Layout>