---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
---

<Layout title="Home">
  
  <section class="comic-panel" style="margin-bottom: 3rem; display: flex; gap: 2rem; align-items: center; flex-wrap: wrap;">
    <div style="flex-shrink: 0; width: 250px; height: 250px; background-color: var(--color-secondary); border: 4px solid var(--color-black); border-radius: 50%; box-shadow: 6px 6px 0px var(--color-black);">
      </div>
    
    <div style="flex: 1; min-width: 300px;">
      <h1 style="font-size: 3.5rem; margin-bottom: 0.5rem;">Hey, I'm Ishan.</h1>
      <h2 style="color: var(--color-secondary); margin-bottom: 1rem;">Systems Architect & Backend Engineer</h2>
      <p style="font-size: 1.1rem; line-height: 1.6; margin-bottom: 1rem;">
        I build high-performance computing solutions and optimized backend architecture. Currently a Computer Science student at <strong>Michigan State University</strong> (with minors in Data Science, Mathematics, and STEM Public Policy), my focus is on deploying lightweight, incredibly fast code.
      </p>
      <p style="font-size: 1.1rem; line-height: 1.6;">
        From architecting sustainable "Green AI" infrastructure to designing efficient databases, I engineer systems that prioritize scale and structural integrity over bloated trends.
      </p>
    </div>
  </section>

  <section class="comic-panel" style="margin-bottom: 4rem;">
    <h2 style="text-align: center; font-size: 2.5rem; margin-bottom: 2rem;">Initiate Protocol</h2>
    
    <div style="display: flex; justify-content: center; gap: 1.5rem; flex-wrap: wrap;">
      <a href="https://linkedin.com/in/your-profile" target="_blank" class="comic-btn">LinkedIn</a>
      <a href="https://github.com/ishansinha5" target="_blank" class="comic-btn">GitHub</a>
      <a href="https://formspree.io/f/your-endpoint-id" class="comic-btn">Secure Comm</a>
      <a href="/Ishan_Sinha_Resume.pdf" download class="comic-btn" style="background-color: var(--color-primary); color: var(--color-white);">Download Resume</a>
    </div>
  </section>

</Layout>