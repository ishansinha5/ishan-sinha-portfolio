---
// src/layouts/Layout.astro
import '../styles/global.css';

const { title } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/ishan-sinha-portfolio/favicon.svg" />
    <title>{title} | Ishan Sinha</title>
</head>
  <body>
    <header class="comic-panel" style="margin: 3rem auto 2rem auto; max-width: 900px; padding: 1rem 2.5rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
      
      <a href="/ishan-sinha-portfolio/" style="text-decoration: none;">
        <div style="position: relative; display: inline-flex; align-items: center; justify-content: center; width: 280px; height: 120px; margin-top: 15px;">
          
          <svg viewBox="0 0 300 120" style="position: absolute; width: 100%; height: 100%; z-index: 1; top: 10px; filter: drop-shadow(6px 6px 0px var(--color-black));">
            <polygon points="5,30 35,5 265,5 295,30 150,115" fill="#D32F2F" stroke="#0B090A" stroke-width="6" stroke-linejoin="round" />
            <polygon points="22,35 45,18 255,18 278,35 150,100" fill="#FFEA00" stroke="#0B090A" stroke-width="5" stroke-linejoin="round" />
          </svg>
          
          <h1 class="text-highlight" style="margin: 0; font-size: 2.2rem; letter-spacing: 2px; position: relative; z-index: 2; transform: translateY(-5px);">ISHAN.DEV</h1>
        </div>
      </a>
      
      <nav style="display: flex; gap: 1rem; flex-wrap: wrap; justify-content: center;">
        <a href="/ishan-sinha-portfolio/" class="nav-btn">HOME</a>
        <a href="/ishan-sinha-portfolio/experience" class="nav-btn">EXPERIENCE</a>
        <a href="/ishan-sinha-portfolio/projects" class="nav-btn">PROJECTS</a>
      </nav>
    </header>

    <main style="max-width: 900px; margin: 0 auto; padding: 0 1rem;">
      <slot /> 
    </main>
  </body>
</html>