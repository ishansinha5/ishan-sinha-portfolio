---
// src/layouts/Layout.astro
import '../styles/global.css';

const { title } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/ishan-sinha-portfolio/favicon.svg" />
    <title>{title} | Ishan Sinha</title>
  </head>
  <body>
    <header class="comic-panel main-header">
      
      <a href="/ishan-sinha-portfolio/" class="logo-link">
        <div class="logo-container">
          <svg viewBox="0 0 300 120" class="logo-svg">
            <polygon points="5,30 35,5 265,5 295,30 150,115" fill="#D32F2F" stroke="#0B090A" stroke-width="6" stroke-linejoin="round" />
            <polygon points="22,35 45,18 255,18 278,35 150,100" fill="#FFEA00" stroke="#0B090A" stroke-width="5" stroke-linejoin="round" />
          </svg>
          <h1 class="text-highlight logo-text">ISHAN.DEV</h1>
        </div>
      </a>
      
      <nav class="main-nav">
        <a href="/ishan-sinha-portfolio/" class="nav-btn">HOME</a>
        <a href="/ishan-sinha-portfolio/experience" class="nav-btn">EXPERIENCE</a>
        <a href="/ishan-sinha-portfolio/projects" class="nav-btn">PROJECTS</a>
      </nav>

    </header>

    <main style="max-width: 900px; margin: 0 auto; padding: 0 clamp(0.5rem, 2vw, 1rem);">
      <slot /> 
    </main>
  </body>
</html>

<style>
  .main-header {
    margin: clamp(1rem, 4vw, 3rem) auto clamp(1rem, 4vw, 2rem) auto;
    max-width: 900px;
    padding: 1rem 2.5rem;
    display: flex;
    justify-content: space-between; 
    align-items: center;
    flex-wrap: wrap;
    gap: 1.5rem;
  }

  .logo-link {
    text-decoration: none;
    flex-shrink: 0; /* Prevents logo from squishing */
  }

  .logo-container {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: clamp(220px, 60vw, 280px);
    height: clamp(95px, 25vw, 120px);
    margin-top: 15px;
  }

  .logo-svg {
    position: absolute;
    width: 100%;
    height: 100%;
    z-index: 1;
    top: 10px;
    filter: drop-shadow(6px 6px 0px var(--color-black));
  }

  .logo-text {
    margin: 0;
    font-size: clamp(1.8rem, 5vw, 2.2rem);
    letter-spacing: 2px;
    position: relative;
    z-index: 2;
    transform: translateY(clamp(-2px, -1vw, -5px));
  }

  .main-nav {
    display: flex;
    gap: 0.8rem;
    flex-wrap: wrap;
    justify-content: flex-end;
  }

  /* Raised to 850px to catch iPads and narrow laptop windows */
  @media (max-width: 850px) {
    .main-header {
      justify-content: center; 
      flex-direction: column;
      padding: 1.5rem 1rem;
    }
    .main-nav {
      justify-content: center;
      width: 100%;
    }
  }
</style>