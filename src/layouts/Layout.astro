---
// src/layouts/Layout.astro
import '../styles/global.css';

const { title } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | Ishan Sinha</title>
  </head>
  <body>
    <header class="comic-panel" style="margin: 2rem auto; max-width: 900px; padding: 1rem 2.5rem; display: flex; justify-content: space-between; align-items: center;">
      <a href="/" style="text-decoration: none;">
        <h1 class="text-highlight" style="margin: 0; font-size: 2.8rem; letter-spacing: 2px;">ISHAN.DEV</h1>
      </a>
      
      <nav style="display: flex; gap: 1rem;">
        <a href="/" class="nav-btn">HOME</a>
        <a href="/experience" class="nav-btn">EXPERIENCE</a>
        <a href="/projects" class="nav-btn">PROJECTS</a>
      </nav>
    </header>

    <main style="max-width: 900px; margin: 0 auto; padding: 0 1rem;">
      <slot /> 
    </main>
  </body>
</html>